generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ticket {
  id          Int           @id @default(autoincrement())
  title       String        @db.VarChar(60)
  description String
  status      ticket_status @default(OPEN)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
}

enum ticket_status {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
