{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",

    "target": "esnext",
    "module": "nodenext",

    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "noEmit": false,

    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*", "prisma7.config.ts"],
  "exclude": ["node_modules", "dist"]
}
